{
  "name": "tanricam-kaju",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/tanricam-kaju/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/tanricam-kaju",
        "command": "pnpm run build"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/tanricam-kaju",
        "command": "pnpm run dev"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/tanricam-kaju",
        "command": "pnpm run check"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/tanricam-kaju",
        "command": "pnpm run check"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/tanricam-kaju",
        "command": "pnpm run check"
      }
    },
    "assets": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/tanricam-kaju",
        "command": "pnpm run assets"
      }
    },
    "mobile-art": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/tanricam-kaju",
        "command": "pnpm run mobile:art"
      }
    },
    "validate-levels": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/tanricam-kaju",
        "command": "pnpm run validate:levels"
      }
    },
    "preview-levels": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/tanricam-kaju",
        "command": "pnpm run preview:levels"
      }
    },
    "android-release": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/tanricam-kaju",
        "command": "pnpm run android:release"
      }
    }
  }
}
